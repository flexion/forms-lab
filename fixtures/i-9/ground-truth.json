{
  "id": "form-i-9-employment-eligibility-verification",
  "title": "Employment Eligibility Verification (Form I-9)",
  "description": "USCIS Form I-9 used to verify the identity and employment authorization of individuals hired for employment in the United States. OMB No. 1615-0047, Expires 05/31/2027.",
  "groups": [
    {
      "id": "section-1-employee-info",
      "title": "Section 1. Employee Information and Attestation",
      "description": "Employees must complete and sign Section 1 of Form I-9 no later than the first day of employment, but not before accepting a job offer.",
      "requirements": [
        {
          "id": "employee-last-name",
          "fieldName": "employeeLastName",
          "label": "Last Name (Family Name)",
          "fieldType": "text",
          "required": true,
          "sensitivity": "pii"
        },
        {
          "id": "employee-first-name",
          "fieldName": "employeeFirstName",
          "label": "First Name (Given Name)",
          "fieldType": "text",
          "required": true,
          "sensitivity": "pii"
        },
        {
          "id": "employee-middle-initial",
          "fieldName": "employeeMiddleInitial",
          "label": "Middle Initial (if any)",
          "fieldType": "text",
          "required": false,
          "sensitivity": "pii"
        },
        {
          "id": "employee-other-last-names",
          "fieldName": "employeeOtherLastNames",
          "label": "Other Last Names Used (if any)",
          "fieldType": "text",
          "required": false,
          "sensitivity": "pii"
        },
        {
          "id": "employee-address",
          "fieldName": "employeeAddress",
          "label": "Address (Street Number and Name)",
          "fieldType": "text",
          "required": true,
          "sensitivity": "pii"
        },
        {
          "id": "employee-apt-number",
          "fieldName": "employeeAptNumber",
          "label": "Apt. Number (if any)",
          "fieldType": "text",
          "required": false,
          "sensitivity": "pii"
        },
        {
          "id": "employee-city",
          "fieldName": "employeeCity",
          "label": "City or Town",
          "fieldType": "text",
          "required": true,
          "sensitivity": "pii"
        },
        {
          "id": "employee-state",
          "fieldName": "employeeState",
          "label": "State",
          "fieldType": "text",
          "required": true,
          "sensitivity": "pii"
        },
        {
          "id": "employee-zip-code",
          "fieldName": "employeeZipCode",
          "label": "ZIP Code",
          "fieldType": "text",
          "required": true,
          "sensitivity": "pii"
        },
        {
          "id": "employee-date-of-birth",
          "fieldName": "employeeDateOfBirth",
          "label": "Date of Birth (mm/dd/yyyy)",
          "fieldType": "date",
          "required": true,
          "sensitivity": "pii"
        },
        {
          "id": "employee-ssn",
          "fieldName": "employeeSsn",
          "label": "U.S. Social Security Number",
          "fieldType": "text",
          "required": false,
          "helpText": "U.S. Social Security Number",
          "sensitivity": "pii"
        },
        {
          "id": "employee-email",
          "fieldName": "employeeEmail",
          "label": "Employee's Email Address",
          "fieldType": "email",
          "required": false,
          "sensitivity": "pii"
        },
        {
          "id": "employee-phone",
          "fieldName": "employeePhone",
          "label": "Employee's Telephone Number",
          "fieldType": "phone",
          "required": false,
          "sensitivity": "pii"
        },
        {
          "id": "citizenship-status",
          "fieldName": "citizenshipStatus",
          "label": "Citizenship or Immigration Status",
          "fieldType": "choice",
          "required": true,
          "helpText": "Check one of the following boxes: 1. A citizen of the United States, 2. A noncitizen national of the United States, 3. A lawful permanent resident, 4. An alien authorized to work until (expiration date, if any)."
        },
        {
          "id": "lawful-permanent-resident-uscis-number",
          "fieldName": "lawfulPermanentResidentUscisNumber",
          "label": "USCIS or A-Number (for lawful permanent resident)",
          "fieldType": "text",
          "required": false,
          "helpText": "Enter USCIS or A-Number if you checked Item Number 3.",
          "sensitivity": "pii"
        },
        {
          "id": "alien-work-authorization-expiration",
          "fieldName": "alienWorkAuthorizationExpiration",
          "label": "Alien authorized to work until (expiration date, if any)",
          "fieldType": "date",
          "required": false,
          "helpText": "Enter the expiration date if you checked Item Number 4.",
          "sensitivity": "pii"
        },
        {
          "id": "alien-uscis-a-number",
          "fieldName": "alienUscisANumber",
          "label": "USCIS A-Number (for alien authorized to work)",
          "fieldType": "text",
          "required": false,
          "helpText": "If you check Item Number 4, enter one of these: USCIS A-Number OR Form I-94 Admission Number OR Foreign Passport Number and Country of Issuance.",
          "sensitivity": "pii"
        },
        {
          "id": "alien-i94-admission-number",
          "fieldName": "alienI94AdmissionNumber",
          "label": "Form I-94 Admission Number",
          "fieldType": "text",
          "required": false,
          "helpText": "If you check Item Number 4, enter one of these: USCIS A-Number OR Form I-94 Admission Number OR Foreign Passport Number and Country of Issuance.",
          "sensitivity": "pii"
        },
        {
          "id": "alien-foreign-passport-number",
          "fieldName": "alienForeignPassportNumber",
          "label": "Foreign Passport Number",
          "fieldType": "text",
          "required": false,
          "helpText": "If you check Item Number 4 and provide a foreign passport number, also provide Country of Issuance.",
          "sensitivity": "pii"
        },
        {
          "id": "alien-foreign-passport-country",
          "fieldName": "alienForeignPassportCountry",
          "label": "Country of Issuance (Foreign Passport)",
          "fieldType": "text",
          "required": false,
          "helpText": "Country of Issuance associated with the Foreign Passport Number.",
          "sensitivity": "pii"
        },
        {
          "id": "employee-signature",
          "fieldName": "employeeSignature",
          "label": "Signature of Employee",
          "fieldType": "text",
          "required": true,
          "helpText": "Employee must sign attesting under penalty of perjury that the information is true and correct.",
          "sensitivity": "pii"
        },
        {
          "id": "employee-signature-date",
          "fieldName": "employeeSignatureDate",
          "label": "Today's Date (mm/dd/yyyy)",
          "fieldType": "date",
          "required": true
        }
      ]
    },
